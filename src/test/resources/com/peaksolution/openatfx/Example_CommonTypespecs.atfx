           xmlns="http://www.asam.net/ODS/5.3.0/Schema">

  <documentation>
    <exported_by>manual</exported_by>
    <exporter>asam_ods</exporter>
    <export_date_time>20121205131445</export_date_time>
    <exporter_version>1.0</exporter_version>
    <short_description>Example for using components with the most common binary encodings</short_description>
    <long_description>This example file demonstrates the usage of components for the values of local column instances with the most common binary encodings, i.e. the simple little endian and big endian encoding of each data type.
The only measurement instance within the file contains a local column instances for each encoding. The values are provided with sequence representation explicit and are stored in a binary file using components.
Note: The binary representation and attributes are the same in mixed mode with external components. 
</long_description>
  </documentation>

  <base_model_version>asam31</base_model_version>

